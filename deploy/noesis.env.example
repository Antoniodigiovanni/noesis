# Owner root, group noesis, mode 0640. Real credentials must never enter Git.
# Also shell-compatible for operator maintenance; no shell expansion is performed by systemd.
NOESIS_ENV=production
# Host-installed interpreter outside /home and /root (ProtectHome=yes).
NOESIS_PYTHON=/usr/bin/python3.12
NOESIS_DATABASE_URL='postgresql+psycopg://noesis:REPLACE@127.0.0.1/noesis'
NOESIS_ORIGIN='https://REPLACE.private.example'
NOESIS_WEB_PORT=8091
NOESIS_MCP_PORT=8092
# Exact private proxy Host values, if loopback Host is not preserved.
NOESIS_MCP_ALLOWED_HOSTS=
NOESIS_MCP_USER_ID='REPLACE_WITH_ACCOUNT_UUID'
NOESIS_MCP_TOKEN_FILE=/etc/noesis/mcp-token
NOESIS_PROVIDER_URL=''
NOESIS_PROVIDER_MODEL=''
NOESIS_PROVIDER_KEY_FILE=/etc/noesis/provider-key
# Use a libpq service file for pg_dump/pg_restore, not a password argument.
PGSERVICEFILE=/etc/noesis/pg_service.conf
PGSERVICE=noesis
